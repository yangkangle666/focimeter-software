{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focimeter.local/schemas/m2_multispot_experimental.schema.json",
  "title": "M2 experimental multispot success output consumed by M3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "module",
    "status",
    "experimental",
    "contract_status",
    "validation_status",
    "validation_scope",
    "metrology_validated",
    "image_type",
    "coordinate_type",
    "spots",
    "quality",
    "matching",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "m2.multispot.experimental.1"},
    "task_id": {"type": "string", "minLength": 1},
    "module": {"const": "m2_image_recognition"},
    "status": {"const": "ok"},
    "experimental": {"const": true},
    "contract_status": {"const": "proposed"},
    "data_source": {"type": "string", "minLength": 1},
    "validation_status": {"const": "software_verified"},
    "validation_scope": {
      "enum": ["simulation_only", "software_only"],
      "description": "simulation_only is used by synthetic fixtures; software_only is used by real-image software validation without metrology claims."
    },
    "metrology_validated": {"const": false},
    "image_type": {"enum": ["calibration", "measurement"]},
    "coordinate_type": {"const": "image_pixel"},
    "spots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "not": {"required": ["spot_id"]},
        "required": ["detection_id", "x", "y", "confidence"],
        "properties": {
          "detection_id": {"type": "integer", "minimum": 0},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "quality_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["detected_count", "is_usable"],
      "properties": {
        "detected_count": {"type": "integer", "minimum": 1},
        "is_usable": {
          "const": true,
          "description": "M2 single-image detection is usable; this does not authorize M3 matching or prescription calculation."
        },
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "matching": {
      "type": "object",
      "required": ["status", "id_scope", "physical_identity_guaranteed"],
      "properties": {
        "status": {"const": "not_performed"},
        "id_scope": {"const": "image_local"},
        "physical_identity_guaranteed": {"const": false},
        "owner_status": {"type": "string", "minLength": 1}
      }
    },
    "error": {"type": "null"}
  }
}
