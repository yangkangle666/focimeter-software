{
  "schema_version": "1.0",
  "config_name": "default_config",
  "camera": {
    "notes": "SIMULATION_ONLY: 使用公开工业相机参数作为第一阶段开发模拟值；真实硬件参数到位后必须替换。",
    "pixel_size_um": 4.8,
    "image_width": 1280,
    "image_height": 1024,
    "sensor_width_mm": 6.1,
    "sensor_height_mm": 4.9,
    "bit_depth": 8,
    "color_mode": "monochrome",
    "exposure_ms_min": 0.01,
    "exposure_ms_max": 100
  },
  "optical": {
    "distance_m": 0.03,
    "hartmann_spacing_mm": null
  },
  "image_processing": {
    "roi_width_ratio": 0.9,
    "roi_height_ratio": 0.9,
    "median_kernel": 3,
    "tophat_kernel": 30,
    "otsu_a": 0.4,
    "otsu_b": 0.7,
    "max_depth": 2
  },
  "recognition": {
    "expected_spot_count": "AUTO",
    "min_spot_count": 4,
    "min_confidence": 0.7
  },
  "calculation": {
    "pixel_threshold": 1.0,
    "angle_unit": "degree",
    "diopter_unit": "D"
  },
  "path_policy": {
    "path_type": "relative_to_project_root",
    "allow_absolute_path": false
  },
  "light_source": {
    "type": "green_led",
    "notes": "TEMP_PARAMETER: 绿光 LED。具体波长、功率、亮度稳定性等待硬件组提供；当前不用于计量验证。"
  },
  "measurement_range": {
    "notes": "REFERENCE_ONLY: 以下范围参考宁波法里奥 FL-8600/FL-800 竞品指标，仅用于代码范围校验，不作为项目正式测量目标。最终指标以甲方/课程/项目验收要求为准。",
    "sphere_diopter_min": -25,
    "sphere_diopter_max": 25,
    "cylinder_diopter_min": -10,
    "cylinder_diopter_max": 10,
    "axis_degree_min": 0,
    "axis_degree_max": 180,
    "prism_diopter_min": 0,
    "prism_diopter_max": 15,
    "addition_diopter_min": 0,
    "addition_diopter_max": 10,
    "lens_diameter_mm_min": 15,
    "lens_diameter_mm_max": 100
  }
}
